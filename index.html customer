  <!-- JAVASCRIPT -->
  <script>
    (() => {
      const $ = (selector, root = document) =>
        root.querySelector(selector);

      const $$ = (selector, root = document) =>
        [...root.querySelectorAll(selector)];

      const toast = $("#toast");
      let toastTimer;
      let activeCategory = "all";

      function showToast(message) {
        toast.textContent = message;
        toast.classList.add("show");

        clearTimeout(toastTimer);

        toastTimer = setTimeout(() => {
          toast.classList.remove("show");
        }, 3000);
      }

      function filterFoods() {
        const query = $("#foodSearch").value
          .trim()
          .toLowerCase();

        let visibleCount = 0;

        $$(".food-card").forEach(card => {
          const categoryMatches =
            activeCategory === "all" ||
            card.dataset.category === activeCategory;

          const searchableText = (
            card.dataset.search + " " + card.innerText
          ).toLowerCase();

          const searchMatches =
            query === "" || searchableText.includes(query);

          const show = categoryMatches && searchMatches;

          card.style.display = show ? "" : "none";

          if (show) visibleCount++;
        });

        $("#emptyMessage").style.display =
          visibleCount ? "none" : "block";
      }

      $("#categoryGrid").addEventListener("click", event => {
        const button = event.target.closest("[data-category]");

        if (!button) return;

        activeCategory = button.dataset.category;

        $$(".category-card").forEach(card => {
          card.classList.toggle("active", card === button);
        });

        filterFoods();
      });

      $("#searchForm").addEventListener("submit", event => {
        event.preventDefault();
        filterFoods();

        $("#explore").scrollIntoView({
          behavior: "smooth",
          block: "start"
        });
      });

      $("#foodSearch").addEventListener("input", filterFoods);

      document.addEventListener("click", event => {
        const button = event.target.closest("[data-message]");

        if (!button) return;

        event.preventDefault();
        showToast(button.dataset.message);
      });

      $("#languageButton").addEventListener("click", () => {
        showToast(
          "Arabic interface is planned for a future update. The current preview is in English."
        );
      });

      $("#profileButton").addEventListener("click", event => {
        event.preventDefault();

        showToast(
          "Customer profile will be enabled after login and backend setup."
        );
      });

      $$(".mobile-navigation a").forEach(link => {
        link.addEventListener("click", () => {
          $$(".mobile-navigation a").forEach(item => {
            item.classList.toggle("active", item === link);
          });
        });
      });

      $("#currentYear").textContent = new Date().getFullYear();

      filterFoods();
    })();
  </script>
